# Copy to .env and fill in at least one key. Never commit .env.
# With no key, a deterministic stub model runs everything offline.
# In Codespaces you can add these as Codespaces secrets instead.

# Free key from https://openrouter.ai/keys (only free ":free" models are used)
OPENROUTER_API_KEY=
# Optional second free provider: https://console.groq.com/keys (no card needed)
GROQ_API_KEY=

# Optional: pin one model. OpenRouter ids must end in ":free". Defaults are in navinib/policy.yaml.
NAVINIB_MODEL=
NAVINIB_GROQ_MODEL=
